# abaper-mcp configuration
# Copy this file to .env and fill in the values for your mode.
#
# SAP credentials are per user. abaper-mcp never reads SAP_HOST,
# SAP_USERNAME, SAP_PASSWORD or SAP_CLIENT: do not put SAP credentials here.

# Transport: stdio (default, local single user) or sse (server)
ABAPER_MODE=stdio

# abaper ADT backend (`abaper serve`)
# - stdio: a backend you run yourself with your own SAP credentials,
#   e.g. `abaper serve --allow-static-sap` on http://localhost:8080
# - sse: the shared backend; each request carries the user's X-SAP-* headers
ABAPER_BACKEND_URL=http://localhost:8080

# ====================================================================
# Server (sse) mode only — required there, refused in stdio mode
# ====================================================================
# Each session's user has their own SAP credentials looked up in cai-bff.
# CAI_BFF_INTERNAL_URL=http://cai-bff:8080
# INTERNAL_SERVICE_SECRET=

# Bearer token required on the MCP endpoint (recommended)
# ABAPER_AUTH_TOKEN=

# Reject requests without X-BF-User-Id/X-BF-Realm with 401 (default true).
# false only changes the failure into a tool error; there is never a
# shared SAP identity.
# ABAPER_REQUIRE_PRINCIPAL=true

# ABAPER_HTTP_HOST=0.0.0.0
# ABAPER_HTTP_PORT=8015

# ====================================================================
# S4 Temporal Integration (Optional)
# ====================================================================
# URL of the s4-temporal API server for batch S/4HANA code analysis
# When set, enables s4-batch-analyze, s4-workflow-status, s4-workflow-result tools
# Direct: http://s4-temporal:8081
# Via gateway: http://gw.internal/xpro
S4_TEMPORAL_URL=
